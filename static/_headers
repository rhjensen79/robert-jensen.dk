/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  # TTFB Optimization headers
  X-DNS-Prefetch-Control: on
  Accept-CH: Viewport-Width, Width, DPR
  Critical-CH: Viewport-Width, Width
  # Early hints for critical resources
  Link: </css/performance.min.css>; rel=preload; as=style
  Link: </scss/main.min.css>; rel=preload; as=style
  Link: </images/profile.webp>; rel=preload; as=image; fetchpriority=high
  
# Enable compression for text-based assets
/*.html
  Content-Encoding: gzip
  Vary: Accept-Encoding

/*.css
  Content-Encoding: gzip
  Vary: Accept-Encoding

/*.js
  Content-Encoding: gzip
  Vary: Accept-Encoding

/*.json
  Content-Encoding: gzip
  Vary: Accept-Encoding

/*.xml
  Content-Encoding: gzip
  Vary: Accept-Encoding

/*.txt
  Content-Encoding: gzip
  Vary: Accept-Encoding

/*.svg
  Content-Encoding: gzip
  Vary: Accept-Encoding

# Cache static assets for 1 year
/images/*
  Cache-Control: public, max-age=31536000, immutable

/favicons/*
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.gif
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

# Cache CSS and JS for 1 year (they have fingerprints)
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

# Cache fonts for 1 year
/*.woff
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.ttf
  Cache-Control: public, max-age=31536000, immutable

/*.eot
  Cache-Control: public, max-age=31536000, immutable

# Cache PDFs and documents for 1 week
/*.pdf
  Cache-Control: public, max-age=604800

# Cache video files for 1 month
/*.mp4
  Cache-Control: public, max-age=2592000

/*.webm
  Cache-Control: public, max-age=2592000

# Cache XML files (sitemaps, feeds) for 1 hour
/*.xml
  Cache-Control: public, max-age=3600

# Cache JSON files for 1 day
/*.json
  Cache-Control: public, max-age=86400

# HTML pages optimized for TTFB
/*.html
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400
  # Additional TTFB optimizations
  X-Content-Type-Options: nosniff
  X-DNS-Prefetch-Control: on
  # Early hints for HTML pages
  Link: </css/performance.min.css>; rel=preload; as=style; crossorigin
  Link: </scss/main.min.css>; rel=preload; as=style; crossorigin

/
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400
  # Homepage specific optimizations
  Link: </images/profile.webp>; rel=preload; as=image; fetchpriority=high

# Cache manifest and service worker files for 0 (immediate revalidation)
/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/service-worker.js
  Cache-Control: public, max-age=0, must-revalidate